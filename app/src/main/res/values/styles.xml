<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Плоская карточка-группа, как в настройках Pixel / iOS -->
    <style name="Widget.MotionCues.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Заголовок раздела над группой -->
    <style name="Widget.MotionCues.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Подпись элемента внутри группы -->
    <style name="Widget.MotionCues.ItemTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.MotionCues.ItemSummary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Кнопка в группе выбора: узкие отступы, подпись в одну строку -->
    <style name="Widget.MotionCues.SegmentButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:hapticFeedbackEnabled">false</item>
    </style>

    <style name="Widget.MotionCues.LevelSlider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:stepSize">1</item>
        <item name="android:valueFrom">1</item>
        <item name="android:valueTo">5</item>
        <item name="labelBehavior">gone</item>
        <item name="tickVisible">true</item>
        <item name="android:hapticFeedbackEnabled">false</item>
    </style>
</resources>
