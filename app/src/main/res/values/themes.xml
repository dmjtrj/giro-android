<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Базовая тема — статичная монохромная палитра (светлая или тёмная по values-night).
        В режиме Monet поверх неё накладываются цвета из обоев (DynamicColors).
    -->
    <style name="Theme.MotionCues" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mc_primary</item>
        <item name="colorOnPrimary">@color/mc_on_primary</item>
        <item name="colorPrimaryContainer">@color/mc_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/mc_on_primary_container</item>
        <item name="colorSecondary">@color/mc_secondary</item>
        <item name="colorOnSecondary">@color/mc_on_secondary</item>
        <item name="colorSecondaryContainer">@color/mc_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/mc_on_secondary_container</item>
        <item name="android:colorBackground">@color/mc_surface</item>
        <item name="colorSurface">@color/mc_surface</item>
        <item name="colorOnSurface">@color/mc_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/mc_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/mc_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/mc_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/mc_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/mc_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/mc_surface_container_highest</item>
        <item name="colorOutline">@color/mc_outline</item>
        <item name="colorOutlineVariant">@color/mc_outline_variant</item>
    </style>
</resources>
