<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!--
        Шестерёнка прибита к правому верхнему углу, а блок «заголовок — превью — текст»
        стоит по вертикали чуть выше центра: распорки делят свободное место 45/55.
        Если блок не помещается (маленький экран), распорки схлопываются и всё прокручивается.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="45" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="?attr/colorOnSurface" />

        <!-- Окно превью: точки и круглая кнопка включения по центру -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MotionCues.Card"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="32dp">

            <com.motioncues.app.overlay.CuePreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/preview_description" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/power_button"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:hapticFeedbackEnabled="false"
                app:cardCornerRadius="44dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/power_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power" />

            </com.google.android.material.card.MaterialCardView>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/cues_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.1"
            android:paddingHorizontal="8dp"
            android:text="@string/cues_summary"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="55" />

    </LinearLayout>

</ScrollView>
